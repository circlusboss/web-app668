{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app668",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d55a84de-50f5-45ce-8d4d-23dd8cd31427","database_name": "web-app668" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2e646886b7284d73b7aea05c233a7d23" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
